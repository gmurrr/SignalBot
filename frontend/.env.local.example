NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL used for trusted payment redirects.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_LEMON_SQUEEZY_CUSTOMER_PORTAL_URL=

# Server-only dashboard table names.
SUPABASE_MARKET_DATA_TABLE=market_data
SUPABASE_SIGNALS_TABLE=signals
SIGNAL_SYMBOL=XAUUSD

# Development-only mock billing. Production runtime disables mock automatically.
ENABLE_MOCK_BILLING=false
BILLING_PROVIDER=lemon_squeezy
BILLING_CHECKOUT_URL=https://checkout-provider.example/session
BILLING_WEBHOOK_SECRET=replace-with-strong-random-secret
