SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# APP_MODE: PROD (live) / BACKTEST (no Supabase writes)
APP_MODE=PROD

MARKET_DATA_TABLE=market_data
SIGNALS_TABLE=signals
SIGNAL_WINDOW_SIZE=360
SIGNAL_EXPIRY_MINUTES=30
SIGNAL_TP_ATR_MULTIPLIER=1.8
SIGNAL_SL_ATR_MULTIPLIER=1.1
PIP_SIZE=0.01
PRICE_DECIMALS=2
SEED_CANDLE_COUNT=400
LOG_LEVEL=INFO

# --- MetaTrader5 (local terminal) ---
MT5_SYMBOL=XAUUSD
DXY_SYMBOL=DXY
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TICK_POLL_INTERVAL_SEC=0.2
MARKET_DATA_THROTTLE_SEC=1.0
H1_SEED_CANDLE_COUNT=260
DXY_SEED_H1_COUNT=260
TRADING_TIMEZONE=Europe/Warsaw

# Backtest output
BACKTEST_CSV_PATH=backtest_results.csv
